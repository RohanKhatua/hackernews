{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "hackernews",
  "compatibility_date": "2026-11-07",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "hackernews"
    }
  ],
  "routes": [
    { "pattern": "hn.rohankhatua.dev", "custom_domain": true }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "a209ff419d4b4aee9090bbafc8f9f8d2"
    }
  ],
  "observability": {
    "enabled": true
  }
}
