// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Subscriber {
  id                  String             @id @default(uuid())
  email               String             @unique
  name                String?
  createdAt           DateTime           @default(now())
  active              Boolean            @default(true)
  confirmedAt         DateTime?
  confirmationToken   String?            @unique
  recommendationToken String             @unique @default(uuid())
  readers             Reader[]
  emailLogs           EmailLog[]
}

model EmailLog {
  id           String      @id @default(uuid())
  subscriberId String?
  recipient    String
  subject      String
  kind         String
  status       String      @default("queued")
  batchKey     String?
  providerId   String?
  error        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  subscriber   Subscriber? @relation(fields: [subscriberId], references: [id], onDelete: SetNull)

  @@unique([batchKey, recipient])
  @@index([recipient])
  @@index([kind, createdAt])
  @@index([providerId])
}

model Admin {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  password      String
  emailVerified DateTime?
  image         String?
  role          String    @default("user")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]

  @@map("User")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  adminId      String   @map("userId")
  expires      DateTime
  admin        Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId], map: "Session_userId_idx")
}

/**
 * A browsing identity (one per device/browser cookie). StoryInteraction rows
 * belong to a Reader; a person (Subscriber) links to one or more Readers as
 * devices subscribe or claim via the magic link.
 * The synthetic reader id `email:<subscriberId>` buckets interactions recorded
 * from email link clicks.
 */
model Reader {
  id           String             @id
  subscriberId String?
  mergedFrom   String?
  createdAt    DateTime           @default(now())
  lastSeenAt   DateTime           @default(now())
  subscriber   Subscriber?        @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  interactions StoryInteraction[]

  @@index([subscriberId])
}

model StoryInteraction {
  id            String   @id @default(uuid())
  readerId      String
  storyId       Int
  type          String
  weight        Int      @default(1)
  count         Int      @default(1)
  storyTitle    String
  storyUrl      String?
  storyBy       String?
  storyScore    Int?
  storyComments Int?
  storyTime     Int?
  domain        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  reader        Reader   @relation(fields: [readerId], references: [id], onDelete: Cascade)

  @@unique([readerId, storyId, type])
  @@index([readerId, updatedAt])
  @@index([storyId])
}
