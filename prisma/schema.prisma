// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Subscriber {
  id                  String             @id @default(uuid())
  email               String             @unique
  name                String?
  createdAt           DateTime           @default(now())
  active              Boolean            @default(true)
  recommendationToken String             @unique @default(uuid())
  interactions        StoryInteraction[]
}

model User {
  id            String             @id @default(uuid())
  name          String?
  email         String             @unique
  password      String
  emailVerified DateTime?
  image         String?
  role          String             @default("user")
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  sessions      Session[]
  interactions  StoryInteraction[]
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model StoryInteraction {
  id            String      @id @default(uuid())
  userId        String?
  subscriberId  String?
  readerId      String
  storyId       Int
  type          String
  weight        Int         @default(1)
  count         Int         @default(1)
  storyTitle    String
  storyUrl      String?
  storyBy       String?
  storyScore    Int?
  storyComments Int?
  storyTime     Int?
  domain        String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  subscriber    Subscriber? @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@unique([readerId, storyId, type])
  @@unique([subscriberId, storyId, type])
  @@index([readerId, updatedAt])
  @@index([subscriberId, updatedAt])
  @@index([userId, updatedAt])
  @@index([storyId])
}
