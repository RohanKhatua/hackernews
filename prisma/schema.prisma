// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Subscriber {
  id                  String             @id @default(uuid())
  email               String             @unique
  name                String?
  createdAt           DateTime           @default(now())
  active              Boolean            @default(true)
  confirmedAt         DateTime?
  confirmationToken   String?            @unique
  recommendationToken String             @unique @default(uuid())
  readers             Reader[]
  emailLogs           EmailLog[]
}

model EmailLog {
  id           String      @id @default(uuid())
  subscriberId String?
  recipient    String
  subject      String
  kind         String
  status       String      @default("queued")
  batchKey     String?
  providerId   String?
  error        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  subscriber   Subscriber? @relation(fields: [subscriberId], references: [id], onDelete: SetNull)

  @@unique([batchKey, recipient])
  @@index([recipient])
  @@index([kind, createdAt])
  @@index([providerId])
}

model Admin {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  password      String
  emailVerified DateTime?
  image         String?
  role          String    @default("user")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]

  @@map("User")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  adminId      String   @map("userId")
  expires      DateTime
  admin        Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId], map: "Session_userId_idx")
}

/**
 * A browsing identity (one per device/browser cookie). StoryInteraction rows
 * belong to a Reader; a person (Subscriber) links to one or more Readers as
 * devices subscribe or claim via the magic link.
 * The synthetic reader id `email:<subscriberId>` buckets interactions recorded
 * from email link clicks.
 */
model Reader {
  id           String             @id
  subscriberId String?
  mergedFrom   String?
  createdAt    DateTime           @default(now())
  lastSeenAt   DateTime           @default(now())
  subscriber   Subscriber?        @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  interactions StoryInteraction[]

  @@index([subscriberId])
}

model StoryInteraction {
  id            String   @id @default(uuid())
  readerId      String
  storyId       Int
  type          String
  weight        Int      @default(1)
  count         Int      @default(1)
  storyTitle    String
  storyUrl      String?
  storyBy       String?
  storyScore    Int?
  storyComments Int?
  storyTime     Int?
  domain        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  reader        Reader   @relation(fields: [readerId], references: [id], onDelete: Cascade)

  @@unique([readerId, storyId, type])
  @@index([readerId, updatedAt])
  @@index([storyId])
}

/**
 * A normalized news story ingested from one of the configured sources
 * (see lib/sources). HN stories keep their numeric item id as externalId;
 * every article also gets a unique slug used by /story/[slug].
 */
model Article {
  id           String           @id @default(cuid())
  sourceId     String
  externalId   String
  slug         String           @unique
  title        String
  url          String?
  text         String?
  excerpt      String?
  author       String?
  sourceLabel  String?
  domain       String?
  categories   String[]
  score        Int?
  commentCount Int?
  publishedAt  DateTime
  ingestedAt   DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  keywords     ArticleKeyword[]

  @@unique([sourceId, externalId])
  @@index([categories(ops: ArrayOps)], type: Gin)
  @@index([sourceId, publishedAt])
  @@index([publishedAt])
}

/**
 * A normalized keyword extracted from article titles/excerpts (see
 * lib/keywords.ts). Each term powers a /topics/[slug] landing page.
 */
model Keyword {
  id           String           @id @default(cuid())
  term         String           @unique
  slug         String           @unique
  articleCount Int              @default(0)
  updatedAt    DateTime         @updatedAt
  articles     ArticleKeyword[]
}

/** Weighted article <-> keyword link built during ingestion. */
model ArticleKeyword {
  articleId String
  keywordId String
  weight    Float
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  keyword   Keyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@id([articleId, keywordId])
  @@index([keywordId, weight])
}
